# Flatpaks. use sudo flatpak remote-add. best using Warehouse (https://flathub.org/en/apps/io.github.flattool.Warehouse)
flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fedora oci+https://registry.fedoraproject.org
elementaryos https://flatpak.elementary.io/repo.flatpakrepo
flathub-beta https://flathub.org/beta-repo/flathub-beta.flatpakrepo
gnome-nightly https://nightly.gnome.org/gnome-nightly.flatpakrepo
eclipse-nightly https://download.eclipse.org/linuxtools/flatpak-I-builds/eclipse.flatpakrepo
webkit-sdk https://software.igalia.com/flatpak-refs/webkit-sdk.flatpakrepo

# for endless os, copy the whole script
sudo wget https://origin.ostree.endlessm.com/keys/eos-flatpak-keyring.gpg && flatpak remote-add --gpg-import=eos-flatpak-keyring.gpg eos-apps https://ostree.endlessm.com/ostree/eos-apps && flatpak remote-add --gpg-import=eos-flatpak-keyring.gpg eos-sdk https://ostree.endlessm.com/ostree/eos-sdk
